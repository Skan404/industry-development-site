---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OptionalAnalytics from "../components/OptionalAnalytics.astro";
import Effects from "../components/Effects.astro";
import { siteConfig } from "../data/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pageTitle = `${title} — ${siteConfig.legalName}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: siteConfig.legalName,
  description: siteConfig.defaultDescription,
  url: canonical.origin,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Płońsk",
    addressRegion: "mazowieckie",
    addressCountry: "PL",
  },
  areaServed: [
    { "@type": "City", name: "Płońsk" },
    { "@type": "AdministrativeArea", name: "województwo mazowieckie" },
    { "@type": "Country", name: "Polska" },
  ],
  priceRange: "199–799 PLN netto / miesiąc",
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a100e" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.legalName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[{ subpage: Astro.url.pathname !== "/" }]}>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <Header />
    <main id="main-content">
      {Astro.url.pathname !== "/" && <Effects kind="grid" />}
      <slot />
    </main>
    <Footer />
    <OptionalAnalytics />
  </body>
</html>
