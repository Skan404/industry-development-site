---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import { projects } from "../data/projects";
---
<BaseLayout title="Realizacje" description="Poznaj strony internetowe wykonane przez Industry Development. Miejsce na nasze zrealizowane projekty.">
  <section class="subpage-hero container"><p class="eyebrow"><i></i> Realizacje / Nasza praca</p><h1>Pomysły, które<br /><em>stały się stronami.</em></h1><p>Każdy projekt zaczyna się od innej historii.<br />Tutaj pokażemy efekty naszej pracy.</p></section>
  <section class="container portfolio-section" aria-label="Wykonane strony internetowe">
    {projects.length === 0 ? <div class="portfolio-empty glow-card"><span class="portfolio-symbol" aria-hidden="true">↗</span><p class="eyebrow">Wkrótce w tym miejscu</p><h2>Nasze realizacje.</h2><p>Przygotowujemy prezentację wykonanych stron.<br />Zapraszamy do rozmowy o Twoim projekcie.</p><a class="button button--outline" href="/kontakt#formularz">Porozmawiajmy <span aria-hidden="true">↗</span></a></div> : <div class="portfolio-grid">{projects.map(project => <article class="portfolio-item glow-card"><a href={project.url} target="_blank" rel="noopener noreferrer"><img src={project.image} alt={project.imageAlt} width="1200" height="800" loading="lazy" /><div><h2>{project.name} <span aria-hidden="true">↗</span></h2><p>{project.description}</p><ul>{project.services.map(service => <li>{service}</li>)}</ul><span class="text-link">Odwiedź stronę <span class="sr-only">(otwiera nową kartę)</span></span></div></a></article>)}</div>}
  </section>
  <ClosingCTA />
</BaseLayout>
