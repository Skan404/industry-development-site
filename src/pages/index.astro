---
import BaseLayout from "../layouts/BaseLayout.astro";
import Effects from "../components/Effects.astro";
import PricingGrid from "../components/PricingGrid.astro";
import PackageComparison from "../components/PackageComparison.astro";
import FAQ from "../components/FAQ.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
const steps = [
  ["Poznajemy Twój biznes", "Rozmawiamy o Twojej ofercie, klientach i tym, co strona ma dla Ciebie robić."],
  ["Nadajemy mu formę", "Układamy treść i projektujemy spójny wygląd. Wiesz, co powstaje, i masz wpływ na kierunek."],
  ["Wprowadzamy w życie", "Wdrażamy projekt, sprawdzamy każdy ekran i przygotowujemy stronę do publikacji."],
  ["Zostajemy w kontakcie", "Po starcie dbamy o hosting, bezpieczeństwo i zmiany. Ty skupiasz się na swojej firmie."],
];
---
<BaseLayout title="Strony, które robią różnicę" description="Projektujemy i rozwijamy strony dla lokalnych firm. Przemyślany design, sprawne działanie i stała opieka. Od 199 zł netto miesięcznie.">
  <div class="rays-zone">
    <Effects kind="rays" />
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-coordinates" aria-hidden="true"><span>52.623601, 20.371888</span><span>Niezależne studio cyfrowe</span></div>
      <p class="eyebrow hero-eyebrow"><i></i> Małe studio. Duże możliwości.</p>
      <h1 id="hero-title" data-typewriter aria-label="Twoja firma. Jej nowy wymiar."><span class="type-line" aria-hidden="true"><span class="type-reserve">Twoja firma.</span><span data-type-first>Twoja firma.</span></span><span class="type-line" aria-hidden="true"><span class="type-reserve">Jej <em>nowa reklama.</em></span><span><span data-type-prefix>Jej </span><em data-type-ending>nowy wymiar.</em></span></span></h1>
      <p class="hero-lead">Tworzymy strony, które przyciągają uwagę<br class="desktop-break" /> i ułatwiają klientom wybór Twojej firmy.</p>
      <div class="hero-actions">
        <a href="/kontakt#formularz" class="button button--primary">Porozmawiajmy o projekcie <span aria-hidden="true">↗</span></a>
        <a href="/uslugi" class="button button--outline">Poznaj nasze usługi <span aria-hidden="true">↓</span></a>
      </div>
      <button class="type-pause" data-type-pause type="button" aria-pressed="false" hidden>Wstrzymaj animację tekstu</button>
      <p class="hero-note">Projekt, wdrożenie i opieka. W jednym miejscu.</p>
      <div class="hero-bottom"><span>Projektujemy lokalnie.<br /><strong>Działamy bez granic.</strong></span><a class="scroll-hint" href="#mozliwosci"><span class="scroll-line" aria-hidden="true"></span> Zobacz, co możemy zrobić</a><span class="hero-availability"><i></i> Płońsk / cała Polska</span></div>
    </section>
    <section id="mozliwosci" class="section services-section container" aria-labelledby="services-title">
      <div class="section-heading"><div><p class="eyebrow">01 / Możliwości</p><h2 id="services-title">Więcej niż<br /><em>ładna strona.</em></h2></div><p>Dobra strona łączy charakter Twojej marki<br class="desktop-break" /> z konkretnym celem. Dbamy o jedno i drugie.</p></div>
      <div class="service-cards">
        <a class="service-card glow-card" href="/uslugi#projektowanie"><span class="card-index">01 <span aria-hidden="true">↗</span></span><div class="service-art art-layout" aria-hidden="true"><div class="mini-window"><div class="mini-top"><i></i><i></i><i></i></div><div class="mini-layout"><span></span><span></span><span></span></div><div class="mini-line"></div></div><span class="art-cursor">↖</span></div><h3>Strony z charakterem</h3><p>Przemyślany projekt, czytelna oferta i detale, po których klienci zapamiętają Twoją firmę.</p><span class="card-tag">Projektowanie i wdrożenie</span></a>
        <a class="service-card glow-card" href="/uslugi#technologia"><span class="card-index">02 <span aria-hidden="true">↗</span></span><div class="service-art art-speed" aria-hidden="true"><div class="speed-gauge"><span>↗<span>szybkość</span></span></div><i class="speed-spark">✧</i></div><h3>Szybkość ma znaczenie</h3><p>Sprawne działanie, wygodna wersja mobilna i techniczne podstawy widoczności w Google.</p><span class="card-tag">Wydajność i użyteczność</span></a>
        <a class="service-card glow-card" href="/uslugi#opieka"><span class="card-index">03 <span aria-hidden="true">↗</span></span><div class="service-art art-orbit" aria-hidden="true"><span class="orbit-ring"></span><span class="orbit-ring orbit-ring--two"></span><span class="orbit-center">↗</span><i></i><i></i></div><h3>Wsparcie po starcie</h3><p>Publikacja to początek. Hosting, aktualizacje i drobne zmiany masz w jednej miesięcznej opłacie.</p><span class="card-tag">Stała opieka i rozwój</span></a>
      </div>
    </section>
  </div>
  <div class="pixels-zone">
    <Effects kind="pixels" />
    <section id="wspolpraca" class="section container process-section" aria-labelledby="process-title">
      <div class="section-heading"><div><p class="eyebrow">02 / Współpraca</p><h2 id="process-title">Od pierwszej rozmowy<br /><em>do dobrego efektu.</em></h2></div><p>Jasny proces. Bez technicznego żargonu.<br />Zawsze wiesz, na jakim jesteśmy etapie.</p></div>
      <ol class="process-grid">{steps.map(([title, copy], i) => <li><span class="step-number">0{i + 1}<i aria-hidden="true"></i></span><h3>{title}</h3><p>{copy}</p></li>)}</ol>
    </section>
    <section class="section container pricing-section" aria-labelledby="pricing-title">
      <div class="section-heading"><div><p class="eyebrow">03 / Prosty model</p><h2 id="pricing-title">Dobry projekt.<br /><em>Przewidywalny koszt.</em></h2></div><div><p>Wybierz zakres dopasowany do swojej firmy.<br />My zajmiemy się resztą.</p><a class="text-link" href="/uslugi#pakiety">Poznaj szczegóły pakietów <span aria-hidden="true">↗</span></a></div></div>
      <PricingGrid compact />
      <PackageComparison />
    </section>
    <section class="section container faq-section" aria-labelledby="faq-title"><div><p class="eyebrow">04 / Warto wiedzieć</p><h2 id="faq-title">Dobre pytania.<br /><em>Proste odpowiedzi.</em></h2><p>Jeszcze coś Cię zastanawia?</p><a href="/kontakt" class="text-link">Porozmawiajmy <span aria-hidden="true">↗</span></a></div><FAQ limit={5} /></section>
    <ClosingCTA />
  </div>
</BaseLayout>