---
import type { projectConcepts } from "../data/site";

type Concept = (typeof projectConcepts)[number];

interface Props {
  project: Concept;
  detailed?: boolean;
}

const { project, detailed = false } = Astro.props;
---

<article class:list={["project-card", `project-card--${project.tone}`, { "project-card--detailed": detailed }]} data-reveal>
  <div class="project-card__visual">
    <div class="project-card__chrome">
      <span>{project.index}</span>
      <span>{project.sector}</span>
    </div>
    {
      project.tone === "graphite" ? (
        <div class="concept concept--nova">
          <div class="concept__nav"><i></i><i></i><i></i></div>
          <p>Przestrzeń<br />doprowadzona<br />do porządku.</p>
          <div class="concept__plan">
            <span></span><span></span><span></span>
          </div>
          <small>NOVA / WNĘTRZA</small>
        </div>
      ) : (
        <div class="concept concept--atelier">
          <div class="concept__arc"></div>
          <small>ATELIER FORMA</small>
          <p>Uważna pielęgnacja.<br />Naturalny efekt.</p>
          <span class="concept__pill">Umów wizytę ↗</span>
          <div class="concept__number">AF</div>
        </div>
      )
    }
  </div>
  <div class="project-card__body">
    <div class="project-card__heading">
      <div>
        <p class="project-card__sector">{project.sector}</p>
        <h3>{project.name}</h3>
      </div>
      <span class="concept-label">Projekt koncepcyjny<br />— nie jest realizacją klienta</span>
    </div>
    <div class="project-card__details">
      <div>
        <span>Problem</span>
        <p>{project.problem}</p>
      </div>
      <div>
        <span>Kierunek</span>
        <p>{project.direction}</p>
      </div>
      <div>
        <span>Droga do kontaktu</span>
        <p>{project.conversion}</p>
      </div>
    </div>
  </div>
</article>
