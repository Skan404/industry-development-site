---


import { siteConfig } from "../data/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "/api/contact.php";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || siteConfig.email;
const enabled = import.meta.env.PUBLIC_FORM_ENABLED === "true" && Boolean(turnstileSiteKey);
---

<form
  class:list={["contact-form", { "contact-form--compact": compact }]}
  data-contact-form
  data-endpoint={enabled ? endpoint : ""}
  method="post"
  action={enabled ? endpoint : undefined}
>
  {!enabled && <div class="form-notice">Wysyłka formularza nie jest jeszcze dostępna.{contactEmail && <> Możesz też <a href={`mailto:${contactEmail}`}>napisać bezpośrednio do nas</a>.</>}</div>}
  <noscript><p class="form-notice">Do obsługi tego formularza potrzebny jest JavaScript.{contactEmail && <a href={`mailto:${contactEmail}`}> Napisz e-mail.</a>}</p><style>.form-submit{display:none!important}</style></noscript>
  <div class="form-grid">
    <div class="field">
      <label for={`name-${compact ? "compact" : "full"}`}>Imię i nazwisko <span aria-hidden="true">*</span></label>
      <input id={`name-${compact ? "compact" : "full"}`} name="name" type="text" autocomplete="name" maxlength="100" required />
      <span class="field__error" data-error-for="name"></span>
    </div>
    <div class="field">
      <label for={`company-${compact ? "compact" : "full"}`}>Nazwa firmy <span aria-hidden="true">*</span></label>
      <input id={`company-${compact ? "compact" : "full"}`} name="company" type="text" autocomplete="organization" maxlength="160" required />
      <span class="field__error" data-error-for="company"></span>
    </div>
    <div class="field">
      <label for={`email-${compact ? "compact" : "full"}`}>E-mail <span aria-hidden="true">*</span></label>
      <input id={`email-${compact ? "compact" : "full"}`} name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required />
      <span class="field__error" data-error-for="email"></span>
    </div>
    <div class="field">
      <label for={`phone-${compact ? "compact" : "full"}`}>Telefon <span>(opcjonalnie)</span></label>
      <input id={`phone-${compact ? "compact" : "full"}`} name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" />
      <span class="field__error" data-error-for="phone"></span>
    </div>
  </div>

  <div class="field field--honeypot" aria-hidden="true">
    <label for={`company-url-${compact ? "compact" : "full"}`}>Adres firmy</label>
    <input id={`company-url-${compact ? "compact" : "full"}`} name="companyUrl" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    enabled && (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-language="pl" data-theme="dark" data-size="flexible"></div>
    )
  }
  {
    enabled && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )
  }

  <div class="form-consent form-information"><p>Dane wykorzystamy, aby odpowiedzieć na Twoje zapytanie. Informacje o administratorze, podstawach przetwarzania i Twoich prawach znajdziesz w <a href="/polityka-prywatnosci">polityce prywatności</a>. Zasady działania formularza określa <a href="/regulamin">regulamin</a>. Wysłanie zapytania nie oznacza zakupu pakietu ani zapisu na marketing.</p></div>

  <div class="form-submit">
    <button class="button button--primary" type="submit" disabled={!enabled}>
      <span data-submit-label>Wyślij zapytanie</span>
      <span aria-hidden="true" data-submit-icon>↗</span>
    </button>
    <p>Odpowiedź w ciągu 1 dnia roboczego.</p>
  </div>
  <div class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status hidden></div>
</form>

<script>
  import { initContactForms } from "../scripts/contact";
  initContactForms();
</script>
