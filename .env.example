# Publiczny adres produkcyjny używany do canonical, robots.txt i sitemap.xml.
SITE_URL=https://twoja-domena.pl

# Endpoint Cloudflare Pages Function lub Workera. Pozostaw pusty lokalnie,
# jeśli wysyłka formularza nie jest jeszcze podłączona.
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=

# Publiczny klucz Cloudflare Turnstile. Token MUSI być weryfikowany po stronie Workera.
PUBLIC_TURNSTILE_SITE_KEY=

# Opcjonalny adres skryptu analitycznego. Skrypt ładuje się dopiero po zapisaniu
# zgody "analytics-consent=granted" w localStorage.
PUBLIC_ANALYTICS_SRC=
