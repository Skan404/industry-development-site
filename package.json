{
  "name": "industry-development",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev",
    "check:cloudflare": "wrangler deploy --dry-run --outdir release/cloudflare-worker",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:php": "node scripts/php-check.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:production": "node scripts/check-release.mjs --production",
    "package:hostido": "npm run build && npm run check:release && node scripts/package-hostido.mjs && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "og": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "sharp": "0.35.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "wrangler": "^4.132.0"
  }
}
